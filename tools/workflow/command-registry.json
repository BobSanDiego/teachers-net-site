{
  "version": 1,
  "commands": [
    {"command": "EXECUTE NEXT", "syntax": "EXECUTE NEXT", "purpose": "Execute the oldest formal pending ticket", "stop": "Stop at human review, failure, dependency, or ticket boundary"},
    {"command": "EXECUTE", "syntax": "EXECUTE <ticket-id>", "purpose": "Execute one named formal ticket", "stop": "Honor the ticket stop boundary"},
    {"command": "EXECUTE ALL PENDING", "syntax": "EXECUTE ALL PENDING", "purpose": "Run pending tickets sequentially", "stop": "Stop at the first gate, failure, review, or dependency"},
    {"command": "RETRY BLOCKED", "syntax": "RETRY BLOCKED <ticket-id>", "purpose": "Retry after the blocker is resolved", "stop": "Stop if the blocker remains"},
    {"command": "SHOW QUEUE", "syntax": "SHOW QUEUE", "purpose": "Display pending, active, blocked, completed, and superseded tickets", "stop": "Inspection only"},
    {"command": "SHOW NEXT", "syntax": "SHOW NEXT", "purpose": "Show the ticket EXECUTE NEXT would select", "stop": "Inspection only"},
    {"command": "MARK SUPERSEDED", "syntax": "MARK SUPERSEDED <ticket-id> BY <replacement-ticket-id>", "purpose": "Record replacement without deleting history", "stop": "Ledger update only"},
    {"command": "ARCHIVE CURRENT", "syntax": "ARCHIVE CURRENT", "purpose": "Archive current Report and Hopper payloads", "stop": "Archive only"},
    {"command": "REBUILD REPORT", "syntax": "REBUILD REPORT", "purpose": "Regenerate the Report from current evidence", "stop": "Report generation only"},
    {"command": "SHOW HOPPER INDEX", "syntax": "SHOW HOPPER INDEX", "purpose": "List cycle evidence", "stop": "Inspection only"},
    {"command": "WORKFLOW STATUS", "syntax": "WORKFLOW STATUS", "purpose": "Report project, cycle, queue, directories, and ledger health", "stop": "Inspection only"},
    {"command": "VALIDATE WORKFLOW", "syntax": "VALIDATE WORKFLOW", "purpose": "Validate structure, registry, ledger, and artifacts", "stop": "Read-only validation"},
    {"command": "LIST COMMANDS", "syntax": "LIST COMMANDS", "purpose": "Render this registry", "stop": "Inspection only"}
  ]
}
